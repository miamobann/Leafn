# 이름만 적는다. 실제 값은 apps/web/.env.local(로컬), Vercel 환경 변수, GitHub Actions Secrets에만 넣는다.
# 자세한 설명: CLAUDE.md 9장

# web (공개 가능, RLS가 보호)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. NEXT_PUBLIC_ 접두사 금지, 브라우저 코드에서 쓰지 않는다
ANTHROPIC_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RAKUTEN_APPLICATION_ID=

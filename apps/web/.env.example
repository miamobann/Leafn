# 이 파일을 .env.local로 복사하고 값을 채운다. .env.local은 커밋하지 않는다 (CLAUDE.md 9장).
# 값 위치: Supabase 대시보드 → Project Settings → API Keys

# 공개 가능 (RLS가 보호)
NEXT_PUBLIC_SUPABASE_URL=
# publishable 키(sb_publishable_...) 또는 legacy anon 키
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. 브라우저·커밋 금지. 지금 단계에서는 비워 둔다
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
RAKUTEN_APPLICATION_ID=

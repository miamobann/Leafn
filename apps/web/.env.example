# 이 파일을 .env.local로 복사하고 값을 채운다. .env.local은 커밋하지 않는다 (CLAUDE.md 9장).
# 연동 방법: docs/SUPABASE_SETUP.md
# 값 위치: Supabase 대시보드 → Project Settings → API Keys

# 공개 가능 (RLS가 보호)
NEXT_PUBLIC_SUPABASE_URL=
# publishable 키(sb_publishable_...) 또는 legacy anon 키
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. 브라우저·커밋 금지. 통합 AI 분석 결과 저장에 필요하며 관리자가 배포 환경에 설정한다
SUPABASE_SERVICE_ROLE_KEY=
# AI (CLAUDE.md 2장): openai(기본) 또는 anthropic. 고른 쪽의 키만 채운다
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# 선택. 비우면 lib/ai/ 설정 파일의 기본 모델
AI_MODEL_PRECISE=
AI_MODEL_BULK=
RAKUTEN_APPLICATION_ID=

# 시장 분석 (PR #22 · SerpApi는 총괄 확인 대기). 서버 전용
# 미래 트렌드: Google 자동완성·Google Trends (https://serpapi.com)
SERPAPI_API_KEY=
# GEO가 측정하는 엔진의 모델 (선택. 비우면 lib/ai/geo/config.ts 기본값). 키는 위 OPENAI_API_KEY·ANTHROPIC_API_KEY를 쓴다
GEO_MODEL_CHATGPT=
GEO_MODEL_CLAUDE=
# GEO 질의 반복 횟수 1~3 (선택. 기본 1, 화면의 정밀 모드는 3)
GEO_REPEAT_COUNT=
# SNS 영상 분석: TikTok 링크 → 캡션·해시태그·발화 자막 (https://apify.com/clockworks/tiktok-scraper). 서버 전용
# 값 위치: Apify → Settings → API & Integrations → Personal API token
APIFY_TOKEN=
